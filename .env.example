# Required on hosting:
DATABASE_URL=postgres://user:password@host:5432/database
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Optional CORS additions. Use comma-separated values when you have several domains.
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
CORS_ALLOWED_ORIGIN_PATTERNS=https://*.vercel.app

# Optional. Most hostings set PORT automatically.
PORT=8080

# Optional database fallback when your hosting does not provide DATABASE_URL.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=service_desk_db
# DB_USER=malik
# DB_PASSWORD=12345678

# Optional JWT tuning.
# JWT_SECRET_ENCODING=auto
# JWT_EXPIRATION=900000
# JWT_REFRESH_EXPIRATION=604800000

# Optional production defaults.
# DDL_AUTO=update
# SHOW_SQL=false
# FORMAT_SQL=false
